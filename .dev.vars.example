# Copy to .dev.vars for local development (`npm run dev`).
# .dev.vars is gitignored — never commit real keys.

ANTHROPIC_API_KEY=sk-ant-your-key-here
GOOGLE_PLACES_API_KEY=your-places-key-here

# Optional dev-only mocks — DO NOT set these in production.
# MOCK_PLACES=1 returns canned business results without calling Google.
# MOCK_ANTHROPIC=1 returns a canned HTML page without calling Anthropic.
#MOCK_PLACES=1
#MOCK_ANTHROPIC=1

# Optional model override (defaults to claude-opus-4-8).
#ANTHROPIC_MODEL=claude-opus-4-8

# Contact-form email alerts (optional feature).
# RESEND_API_KEY: from resend.com (free tier). When set, generated sites can
# email their contact-form submissions to the address you enter in the builder.
# MAIL_FROM: the "from" sender — needs a domain verified in Resend to deliver
# to arbitrary client inboxes; without it, Resend only delivers to your own
# account email. Format: "Leads <leads@yourdomain.com>".
# FORM_SIGNING_SECRET: optional; if unset, the RESEND_API_KEY is used to sign
# form tokens. Set a random value if you rotate your Resend key often.
#RESEND_API_KEY=re_your_key_here
#MAIL_FROM=Forge Leads <leads@yourdomain.com>
#FORM_SIGNING_SECRET=
#MOCK_EMAIL=1
