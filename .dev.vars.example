# Copy to .dev.vars for local development (`npm run dev`).
# .dev.vars is gitignored — never commit real keys.

ANTHROPIC_API_KEY=sk-ant-your-key-here
GOOGLE_PLACES_API_KEY=your-places-key-here

# Optional dev-only mocks — DO NOT set these in production.
# MOCK_PLACES=1 returns canned business results without calling Google.
# MOCK_ANTHROPIC=1 returns a canned HTML page without calling Anthropic.
#MOCK_PLACES=1
#MOCK_ANTHROPIC=1

# Optional model override (defaults to claude-opus-4-8).
#ANTHROPIC_MODEL=claude-opus-4-8

# Optional model for the Camera page's framing call (defaults to claude-opus-5-5).
# MOCK_ANTHROPIC=1 also returns a canned framing box so /camera works offline.
#CAMERA_MODEL=claude-opus-5-5

# Note: the generated sites' contact forms are self-contained (they open the
# visitor's email app addressed to the client), so no email service, API key,
# or signing secret is needed for them anymore.

# Optional app password lock. Set FORGE_PASSWORD to require a login page before
# anyone can open the Forge app. Leaving it unset means no lock (open app).
# Public paths (/preview/* and /api/pv) stay open either way so client links work.
#FORGE_PASSWORD=choose-a-password
