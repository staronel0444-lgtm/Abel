# Copy to .dev.vars and fill in. .dev.vars is gitignored.

# Server-side Anthropic key (used by every agent). Required unless MOCK_ANTHROPIC=1.
ANTHROPIC_API_KEY=

# Optional model override. Defaults to claude-opus-4-8.
# ANTHROPIC_MODEL=claude-opus-4-8

# Dev-only: return canned agent output with no key and no spend. Never set in production.
# MOCK_ANTHROPIC=1
